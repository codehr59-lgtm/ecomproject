APP_NAME=Shuvo
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Switch to mysql for production; sqlite is used in dev (see phpunit.xml)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shuvo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────────
# Use 'log' for dev, 'smtp'/'mailgun'/'ses' for production
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@shuvo.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / S3 (optional remote backup or file storage) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Backup (spatie/laravel-backup) ────────────────────────────────────────────
BACKUP_NAME=shuvo
# BACKUP_ARCHIVE_PASSWORD=

# ── Payment Gateways (Phase B5) ──────────────────────────────────────────────
# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_SANDBOX=true

# Rocket (DBBL)
ROCKET_MERCHANT_ID=
ROCKET_MERCHANT_PASSWORD=
ROCKET_SANDBOX=true

# ── Courier APIs ─────────────────────────────────────────────────────────────
# Pathao
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_SANDBOX=true

# Steadfast
STEADFAST_API_KEY=
STEADFAST_API_SECRET=

# ── Analytics & Pixels (Phase B7) ────────────────────────────────────────────
FB_PIXEL_ID=
GA_ID=

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
