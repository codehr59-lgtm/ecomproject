{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/storage/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(css|js|images|build|favicon.ico|robots.txt)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Shuvo Grocery",
    "APP_ENV": "production",
    "APP_URL": "https://ecomproject-code-hr.vercel.app",
    "ASSET_URL": "https://ecomproject-code-hr.vercel.app",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:5N28+WmxmUCPos7oTo4eneqQzfT+/7gYVheB/ap3E3w=",
    "APP_TIMEZONE": "Asia/Dhaka",
    "LOG_CHANNEL": "stderr",
    "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php",
    "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "file",
    "SESSION_DRIVER": "database",
    "APP_MAINTENANCE_DRIVER": "file",
    "QUEUE_CONNECTION": "sync",
    "BROADCAST_CONNECTION": "log",
    "FILESYSTEM_DISK": "local",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-0-ap-southeast-2.pooler.supabase.com",
    "DB_PORT": "5432",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.pctusbarnqdkvfmypvwv",
    "DB_PASSWORD": "YIVZMVhqUqWfUIAS",
    "DB_SSLMODE": "require"
  }
}
